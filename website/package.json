{
  "name": "kalima-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/verify-screenshots.mjs && tsc --noEmit && vite build",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy dist --project-name kalima --branch main",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/verify-screenshots.mjs && tsc --noEmit",
    "verify:screenshots": "node scripts/verify-screenshots.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
